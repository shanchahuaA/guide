/* pages/profile/profile.wxss */

page {
  background-color: #f7f4ea;
  background-image: radial-gradient(#e2dcc6 1.5rpx, transparent 1.5rpx);
  background-size: 20rpx 20rpx;
  /* 底部给自定义 tabBar 留高度 */
  padding-bottom: 140rpx;
}

/* 与 teach / detail 同一套卡片语言：米白底 + 细描边、无阴影 */
.section {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  background: #fffdf6;
  border: 2rpx solid #e6e0cc;
  border-radius: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b2823;
  margin-bottom: 20rpx;
}

.hint {
  font-size: 26rpx;
  line-height: 1.6;
  color: #9a9384;
  margin-bottom: 20rpx;
}

.input {
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #2b2823;
  background: #f7f4ea;
  border: 2rpx solid #e6e0cc;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.btn {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #6b6353;
  background: #f0ebdb;
  border: 2rpx solid #ded7c2;
  border-radius: 16rpx;
}

.btn[disabled] {
  opacity: 0.6;
  background: #f0ebdb;
  color: #9a9384;
}

/* ── 头像 + 昵称 ──────────────────────────────────────────────────────── */

.id-row {
  display: flex;
  align-items: center;
}

/* chooseAvatar 的按钮：去掉小程序 button 的默认样式，只当个可点的框用 */
.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  margin: 0 24rpx 0 0;
  padding: 0;
  background: #f7f4ea;
  border: 2rpx solid #e6e0cc;
  border-radius: 50%;
  overflow: hidden;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 22rpx;
  color: #9a9384;
}

.nickname-input {
  flex: 1;
}

/* ── 身份 ────────────────────────────────────────────────────────────── */

.id-line {
  display: flex;
  align-items: center;
}

.id-level {
  font-size: 34rpx;
  font-weight: 600;
  color: #2b2823;
}

.id-streak {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #9a9384;
}

/* 跳级按钮（仅演示）：一枚描边小胶囊 */
.jump {
  margin-left: auto;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #6b6353;
  background: #f0ebdb;
  border: 2rpx solid #ded7c2;
  border-radius: 28rpx;
}
