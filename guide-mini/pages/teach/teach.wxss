/* pages/teach/teach.wxss */

page {
  background-color: #f7f4ea;
  background-image: radial-gradient(#e2dcc6 1.5rpx, transparent 1.5rpx);
  background-size: 20rpx 20rpx;
  /* 顶部身份条 + 底部给自定义 tabBar 留高度 */
  padding-bottom: 140rpx;
}

/* 身份条：常驻在页面顶部，和详情页的 section 同一套卡片语言（无阴影） */
.identity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 24rpx 0;
}

.identity-text {
  display: flex;
  align-items: baseline;
}

.identity-level {
  font-size: 34rpx;
  font-weight: 600;
  color: #2b2823;
}

.identity-streak {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #9a9384;
}

/* 跳级按钮（仅演示）：一枚描边小胶囊 */
.jump {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #6b6353;
  background: #f0ebdb;
  border: 2rpx solid #ded7c2;
  border-radius: 28rpx;
}

/* 「问答」分段的卡片。与详情页的 section 同一套语言：米白底 + 细描边、无阴影 */
.section {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  background: #fffdf6;
  border: 2rpx solid #e6e0cc;
  border-radius: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b2823;
  margin-bottom: 20rpx;
}

.hint {
  font-size: 26rpx;
  line-height: 1.6;
  color: #9a9384;
  margin-bottom: 20rpx;
}

.input {
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #2b2823;
  background: #f7f4ea;
  border: 2rpx solid #e6e0cc;
  border-radius: 16rpx;
}

.btn {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #6b6353;
  background: #f0ebdb;
  border: 2rpx solid #ded7c2;
  border-radius: 16rpx;
}

/* 禁用态（提问中）：按钮 self 去掉立体感，免得看起来能再点一次 */
.btn[disabled] {
  opacity: 0.6;
  background: #f0ebdb;
  color: #9a9384;
}

.answer {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #f7f4ea;
  border-radius: 16rpx;
}

.answer-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #3d3830;
  /* 答案是多行长文本，保留换行 */
  white-space: pre-wrap;
}

/* ── 「练习」分段（契约 §7.3）──────────────────────────────────────────── */

.quiz-stem {
  font-size: 30rpx;
  line-height: 1.6;
  color: #2b2823;
  margin-bottom: 20rpx;
}

.quiz-option {
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #3d3830;
  background: #f7f4ea;
  border: 2rpx solid #e6e0cc;
  border-radius: 16rpx;
}

/* 答完才上色：正确答案绿、选错的红。未作答时全部是中性色 */
.quiz-option.is-correct {
  color: #2f6b3a;
  background: #eaf4ec;
  border-color: #b8d8bf;
}

.quiz-option.is-wrong {
  color: #9b3b33;
  background: #f7eae8;
  border-color: #e0b7b1;
}

.quiz-result {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #efe9d6;
}

.quiz-verdict {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.quiz-verdict.is-right {
  color: #2f6b3a;
}

.quiz-verdict.is-wrong {
  color: #9b3b33;
}

.quiz-explanation {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6b6353;
  margin-bottom: 8rpx;
}
