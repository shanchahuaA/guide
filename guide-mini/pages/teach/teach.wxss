/* pages/teach/teach.wxss */

page {
  background-color: #f7f4ea;
  background-image: radial-gradient(#e2dcc6 1.5rpx, transparent 1.5rpx);
  background-size: 20rpx 20rpx;
  /* 底部给自定义 tabBar 留高度 */
  padding-bottom: 140rpx;
}

/* 与详情页的 section 同一套卡片语言：米白底 + 细描边、无阴影 */
.section {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  background: #fffdf6;
  border: 2rpx solid #e6e0cc;
  border-radius: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b2823;
  margin-bottom: 20rpx;
}

.hint {
  font-size: 26rpx;
  line-height: 1.6;
  color: #9a9384;
  margin-bottom: 20rpx;
}

.input {
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #2b2823;
  background: #f7f4ea;
  border: 2rpx solid #e6e0cc;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.btn {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #6b6353;
  background: #f0ebdb;
  border: 2rpx solid #ded7c2;
  border-radius: 16rpx;
}

/* 禁用态（提问中）：按钮 self 去掉立体感，免得看起来能再点一次 */
.btn[disabled] {
  opacity: 0.6;
  background: #f0ebdb;
  color: #9a9384;
}

/* 次级按钮（重置练习）：不上底色、只留描边，和主按钮拉开层级 */
.btn--ghost {
  color: #9a9384;
  background: transparent;
  border-color: #e6e0cc;
}

.answer {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #f7f4ea;
  border-radius: 16rpx;
}

.answer-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #3d3830;
  /* 答案是多行长文本，保留换行 */
  white-space: pre-wrap;
}

/* ── 身份条 + 能力解锁条（契约 §7.0 / §7.6）────────────────────────────── */

.identity {
  display: flex;
  flex-direction: column;
}

.id-line {
  display: flex;
  align-items: center;
}

.id-level {
  font-size: 34rpx;
  font-weight: 600;
  color: #2b2823;
}

.id-streak {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #9a9384;
}

/* 跳级按钮（仅演示）：一枚描边小胶囊 */
.jump {
  margin-left: auto;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #6b6353;
  background: #f0ebdb;
  border: 2rpx solid #ded7c2;
  border-radius: 28rpx;
}

/* 三枚能力 chip：现在是解锁的那几个亮着，灰的是还没到等级 */
.caps {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.cap {
  margin: 0 16rpx 12rpx 0;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #b3ab99;
  background: #f2eee1;
  border: 2rpx solid #e6e0cc;
  border-radius: 28rpx;
}

.cap.is-on {
  color: #2f6b3a;
  background: #eaf4ec;
  border-color: #b8d8bf;
}

/* ── 分段导航：问答 / 练习 / 路线 ─────────────────────────────────────── */

.seg {
  display: flex;
  margin: 24rpx 24rpx 0;
  padding: 6rpx;
  background: #efe9d6;
  border-radius: 999rpx;
}

.seg-item {
  flex: 1;
  padding: 14rpx 0;
  font-size: 27rpx;
  text-align: center;
  color: #7a7263;
  border-radius: 999rpx;
  transition: background 200ms ease, color 200ms ease;
}

.seg-item.is-on {
  color: #2b2823;
  font-weight: 600;
  background: #fffdf6;
}

/* ── 聊天界面（问答）────────────────────────────────────────────────── */

.chat {
  height: 520rpx;
  padding: 4rpx;
  box-sizing: border-box;
}

.chat-empty {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #9a9384;
  text-align: center;
}

.msg {
  display: flex;
  margin-bottom: 20rpx;
}

/* 用户气泡靠右，AI 靠左 */
.msg--user {
  justify-content: flex-end;
}

.msg--ai {
  justify-content: flex-start;
}

.bubble {
  max-width: 76%;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  border-radius: 20rpx;
}

.msg--user .bubble {
  color: #2b2823;
  background: #dfead2;
  border: 2rpx solid #c6d9b0;
}

.msg--ai .bubble {
  color: #3d3830;
  background: #f7f4ea;
  border: 2rpx solid #e6e0cc;
}

/* 「思考中…」占位：淡一点，别让它看起来像最终答案 */
.bubble.is-pending {
  color: #9a9384;
}

.chat-input {
  margin-top: 20rpx;
}

/* ── 路线分段（契约 §7.4）────────────────────────────────────────────── */

/* 非高手：按钮置灰但仍可点 —— 点了弹本地提示、不发请求 */
.route-btn.is-disabled {
  opacity: 0.7;
  color: #9a9384;
  background: #f0ebdb;
  border-color: #ded7c2;
}

/* 一条路线链接：标题在上、URL 在下，点一条复制 */
.route-link {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #fffdf6;
  border: 2rpx solid #e6e0cc;
  border-radius: 16rpx;
}

.route-link-title {
  display: block;
  font-size: 28rpx;
  color: #3d3830;
  margin-bottom: 6rpx;
}

.route-link-url {
  display: block;
  font-size: 24rpx;
  color: #6b6353;
  word-break: break-all;
}

/* ── 练习分段（契约 §7.3）────────────────────────────────────────────── */

.quiz-stem {
  font-size: 30rpx;
  line-height: 1.6;
  color: #2b2823;
  margin-bottom: 20rpx;
}

.quiz-option {
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #3d3830;
  background: #f7f4ea;
  border: 2rpx solid #e6e0cc;
  border-radius: 16rpx;
}

/* 答完才上色：正确答案绿、选错的红。未作答时全部是中性色 */
.quiz-option.is-correct {
  color: #2f6b3a;
  background: #eaf4ec;
  border-color: #b8d8bf;
}

.quiz-option.is-wrong {
  color: #9b3b33;
  background: #f7eae8;
  border-color: #e0b7b1;
}

.quiz-result {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #efe9d6;
}

.quiz-verdict {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.quiz-verdict.is-right {
  color: #2f6b3a;
}

.quiz-verdict.is-wrong {
  color: #9b3b33;
}

.quiz-explanation {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6b6353;
  margin-bottom: 8rpx;
}
