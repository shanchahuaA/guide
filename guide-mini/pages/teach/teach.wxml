<!--pages/teach/teach.wxml-->
<!-- 身份条：profile 拿到之前不渲染，避免闪一行 "连对 /" 的空壳。
     profile 为 null 只发生在未登录 / 后端没起，此时整条不显示 -->
<view class="identity section" wx:if="{{profile}}">
  <view class="identity-text">
    <text class="identity-level">{{profile.levelName}}</text>
    <text class="identity-streak">连对 {{profile.streak}}/{{profile.streakTarget}}</text>
  </view>
  <!-- 演示用跳级后门：连点三次升一级（契约 §7.6） -->
  <view class="jump" bindtap="onTapJump">跳级 {{taps}}/3</view>
</view>

<!-- 「问答」分段（契约 §7.4）。本单只做图鉴内问题；「路线」是后面一条切片 -->
<view class="section">
  <view class="section-title">问答</view>

  <!-- 没存 Key 时先引导填写。hasApiKey 来自身份条那份 profile -->
  <block wx:if="{{profile && !profile.hasApiKey}}">
    <view class="hint">问答要用你自己的 DeepSeek API Key。填一次就长期有效，只存在你的账号下。</view>
    <input class="input" type="text" password placeholder="sk-..." value="{{keyDraft}}" bindinput="onKeyInput" />
    <button class="btn" bindtap="onSaveKey">保存 Key</button>
  </block>

  <block wx:else>
    <input class="input" type="text" placeholder="问问图鉴里的事，比如「蘑菇有什么用」"
           value="{{question}}" bindinput="onQuestionInput" confirm-type="send" bindconfirm="onAsk" />
    <button class="btn" bindtap="onAsk" disabled="{{asking}}">{{asking ? '思考中…' : '提问'}}</button>

    <view class="answer" wx:if="{{answer}}">
      <text class="answer-text">{{answer}}</text>
    </view>
  </block>
</view>

<!-- 「练习」分段（契约 §7.3）：四选一，后端判题，答完展开解析。连对 10 题升一级 -->
<view class="section">
  <view class="section-title">练习</view>

  <!-- 出题要用用户自己的 Key，没填先引导 -->
  <block wx:if="{{profile && !profile.hasApiKey}}">
    <view class="hint">出题也要用你自己的 DeepSeek API Key，先在上面填好再回来练。</view>
  </block>

  <block wx:elif="{{quiz}}">
    <view class="quiz-stem">{{quiz.stem}}</view>

    <view class="quiz-option {{quizResult ? (index === quizResult.correctIndex ? 'is-correct' : (index === selectedIndex ? 'is-wrong' : '')) : ''}}"
          wx:for="{{quiz.options}}" wx:key="index"
          data-index="{{index}}" bindtap="onChooseOption">{{item}}</view>

    <view class="quiz-result" wx:if="{{quizResult}}">
      <text class="quiz-verdict {{quizResult.correct ? 'is-right' : 'is-wrong'}}">{{quizResult.correct ? '答对了' : '答错了'}}</text>
      <text class="quiz-explanation">正确答案：{{quiz.options[quizResult.correctIndex]}}</text>
      <text class="quiz-explanation">{{quizResult.explanation}}</text>
      <button class="btn" bindtap="onNextQuestion">下一题</button>
    </view>
  </block>

  <block wx:elif="{{profile}}">
    <button class="btn" bindtap="loadQuiz" disabled="{{quizLoading}}">{{quizLoading ? '出题中…' : '开始练习'}}</button>
  </block>
</view>
