.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
}

.tab-bar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-bar__icon,
.tab-bar__text {
  /* 以自身底边为原点：放大时底边固定，只往上长。
     另外 transform 不参与布局，所以放大不会把旁边未选中的 tab 挤走。 */
  transform-origin: center bottom;
  transform: scale(1);
  transition: transform 240ms cubic-bezier(0.34, 1.4, 0.64, 1);
}

.tab-bar__icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-bar__item--active .tab-bar__icon {
  transform: scale(1.5);
}

.tab-bar__text {
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 1;
  color: #999999;
  transition: transform 240ms cubic-bezier(0.34, 1.4, 0.64, 1),
              color 240ms ease;
}

.tab-bar__item--active .tab-bar__text {
  transform: scale(1.1);
  color: #07c160;
}
